{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/artist-report-v0.1.json",
  "title": "Automated Artist Report v0.1",
  "type": "object",
  "required": [
    "report_metadata",
    "artist_identity",
    "at_a_glance",
    "artistic_practice",
    "exhibitions",
    "gallery_representation",
    "public_market",
    "recent_activity",
    "sources",
    "claims",
    "limitations"
  ],
  "properties": {
    "report_metadata": { "$ref": "#/$defs/reportMetadata" },
    "artist_identity": { "$ref": "#/$defs/artistIdentity" },
    "at_a_glance": { "$ref": "#/$defs/section" },
    "biography_and_career": { "$ref": "#/$defs/section" },
    "artistic_practice": { "$ref": "#/$defs/section" },
    "practice_timeline": {
      "allOf": [
        { "$ref": "#/$defs/sectionState" },
        {
          "type": "object",
          "properties": {
            "phases": {
              "type": "array",
              "items": { "$ref": "#/$defs/practicePhase" }
            }
          }
        }
      ]
    },
    "selected_works": {
      "allOf": [
        { "$ref": "#/$defs/sectionState" },
        {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": { "$ref": "#/$defs/work" }
            }
          }
        }
      ]
    },
    "exhibitions": {
      "allOf": [
        { "$ref": "#/$defs/sectionState" },
        {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": { "$ref": "#/$defs/exhibition" }
            }
          }
        }
      ]
    },
    "institutional_presence": {
      "allOf": [
        { "$ref": "#/$defs/sectionState" },
        {
          "type": "object",
          "properties": {
            "collections": {
              "type": "array",
              "items": { "$ref": "#/$defs/institutionalRecord" }
            },
            "institutional_exhibitions": {
              "type": "array",
              "items": { "$ref": "#/$defs/institutionalRecord" }
            },
            "commissions": {
              "type": "array",
              "items": { "$ref": "#/$defs/institutionalRecord" }
            },
            "scholarly_publications": {
              "type": "array",
              "items": { "$ref": "#/$defs/institutionalRecord" }
            }
          }
        }
      ]
    },
    "gallery_representation": {
      "allOf": [
        { "$ref": "#/$defs/sectionState" },
        {
          "type": "object",
          "properties": {
            "current": {
              "type": "array",
              "items": { "$ref": "#/$defs/galleryRelationship" }
            },
            "previous": {
              "type": "array",
              "items": { "$ref": "#/$defs/galleryRelationship" }
            }
          }
        }
      ]
    },
    "public_market": { "$ref": "#/$defs/publicMarket" },
    "recent_activity": {
      "allOf": [
        { "$ref": "#/$defs/sectionState" },
        {
          "type": "object",
          "properties": {
            "window_start": { "$ref": "#/$defs/dateValue" },
            "window_end": { "$ref": "#/$defs/dateValue" },
            "events": {
              "type": "array",
              "items": { "$ref": "#/$defs/event" }
            }
          }
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "limitations": {
      "type": "array",
      "items": { "$ref": "#/$defs/limitation" }
    }
  },
  "$defs": {
    "coverageState": {
      "type": "string",
      "enum": ["available", "limited", "conflicting", "not_found"]
    },
    "dateValue": {
      "type": "object",
      "required": ["display"],
      "properties": {
        "iso": { "type": ["string", "null"], "format": "date" },
        "year": { "type": ["integer", "null"] },
        "display": { "type": "string" },
        "precision": {
          "type": "string",
          "enum": ["day", "month", "year", "approximate", "unknown"]
        }
      }
    },
    "reportMetadata": {
      "type": "object",
      "required": [
        "report_id",
        "artist_entity_id",
        "generated_at",
        "information_cutoff",
        "report_version",
        "coverage_state",
        "automated_generation_disclosure"
      ],
      "properties": {
        "report_id": { "type": "string" },
        "artist_entity_id": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "information_cutoff": { "type": "string", "format": "date-time" },
        "report_version": { "type": "string" },
        "coverage_state": { "$ref": "#/$defs/coverageState" },
        "source_counts_by_tier": {
          "type": "object",
          "properties": {
            "tier_1": { "type": "integer", "minimum": 0 },
            "tier_2": { "type": "integer", "minimum": 0 },
            "tier_3": { "type": "integer", "minimum": 0 }
          }
        },
        "automated_generation_disclosure": { "type": "string" }
      }
    },
    "artistIdentity": {
      "type": "object",
      "required": ["preferred_name", "name_variants", "primary_media", "disambiguation_note"],
      "properties": {
        "preferred_name": { "type": "string" },
        "native_language_name": { "type": ["string", "null"] },
        "name_variants": { "type": "array", "items": { "type": "string" } },
        "birth": { "$ref": "#/$defs/placeDate" },
        "death": { "$ref": "#/$defs/placeDate" },
        "current_bases": { "type": "array", "items": { "type": "string" } },
        "documented_nationalities_or_cultural_identifications": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourcedLabel" }
        },
        "education": {
          "type": "array",
          "items": { "$ref": "#/$defs/educationRecord" }
        },
        "primary_media": { "type": "array", "items": { "type": "string" } },
        "current_representation_names": { "type": "array", "items": { "type": "string" } },
        "disambiguation_note": { "type": "string" },
        "claim_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "placeDate": {
      "type": ["object", "null"],
      "properties": {
        "date": { "$ref": "#/$defs/dateValue" },
        "place": { "type": ["string", "null"] }
      }
    },
    "sourcedLabel": {
      "type": "object",
      "required": ["label", "claim_ids"],
      "properties": {
        "label": { "type": "string" },
        "claim_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "educationRecord": {
      "type": "object",
      "required": ["institution", "claim_ids"],
      "properties": {
        "institution": { "type": "string" },
        "degree": { "type": ["string", "null"] },
        "field": { "type": ["string", "null"] },
        "start": { "$ref": "#/$defs/dateValue" },
        "end": { "$ref": "#/$defs/dateValue" },
        "claim_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "sectionState": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": { "$ref": "#/$defs/coverageState" },
        "state_note": { "type": ["string", "null"] }
      }
    },
    "section": {
      "allOf": [
        { "$ref": "#/$defs/sectionState" },
        {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "summary": { "type": "string" },
            "claim_ids": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "practicePhase": {
      "type": "object",
      "required": ["label", "date_range", "summary", "claim_ids"],
      "properties": {
        "label": { "type": "string" },
        "date_range": {
          "type": "object",
          "properties": {
            "start": { "$ref": "#/$defs/dateValue" },
            "end": { "$ref": "#/$defs/dateValue" }
          }
        },
        "summary": { "type": "string" },
        "media": { "type": "array", "items": { "type": "string" } },
        "formal_characteristics": { "type": "array", "items": { "type": "string" } },
        "recurring_subjects": { "type": "array", "items": { "type": "string" } },
        "representative_work_ids": { "type": "array", "items": { "type": "string" } },
        "claim_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "work": {
      "type": "object",
      "required": ["work_id", "title", "claim_ids"],
      "properties": {
        "work_id": { "type": "string" },
        "title": { "type": "string" },
        "series": { "type": ["string", "null"] },
        "date": { "$ref": "#/$defs/dateValue" },
        "medium": { "type": ["string", "null"] },
        "dimensions_display": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "role_in_practice": { "type": ["string", "null"] },
        "image_source_id": { "type": ["string", "null"] },
        "image_rights_status": { "type": ["string", "null"] },
        "related_entity_ids": { "type": "array", "items": { "type": "string" } },
        "claim_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "exhibition": {
      "type": "object",
      "required": ["title", "venue", "classification", "claim_ids"],
      "properties": {
        "title": { "type": "string" },
        "venue": { "type": "string" },
        "venue_type": {
          "type": "string",
          "enum": ["public_museum", "public_art_space", "commercial_gallery", "private_foundation", "biennial", "art_fair", "educational_institution", "other", "unknown"]
        },
        "city": { "type": ["string", "null"] },
        "country": { "type": ["string", "null"] },
        "start": { "$ref": "#/$defs/dateValue" },
        "end": { "$ref": "#/$defs/dateValue" },
        "classification": {
          "type": "string",
          "enum": ["solo", "group", "commission", "retrospective", "survey", "other"]
        },
        "status": { "type": "string", "enum": ["completed", "current", "announced", "canceled", "unknown"] },
        "claim_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "institutionalRecord": {
      "type": "object",
      "required": ["institution", "record_type", "claim_ids"],
      "properties": {
        "institution": { "type": "string" },
        "record_type": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "date": { "$ref": "#/$defs/dateValue" },
        "claim_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "galleryRelationship": {
      "type": "object",
      "required": ["gallery", "relationship_type", "claim_ids"],
      "properties": {
        "gallery": { "type": "string" },
        "relationship_type": { "type": "string", "enum": ["representation", "collaboration", "previous_representation"] },
        "start": { "$ref": "#/$defs/dateValue" },
        "end": { "$ref": "#/$defs/dateValue" },
        "locations": { "type": "array", "items": { "type": "string" } },
        "solo_exhibition_count": { "type": ["integer", "null"], "minimum": 0 },
        "group_exhibition_count": { "type": ["integer", "null"], "minimum": 0 },
        "verified_at": { "type": ["string", "null"], "format": "date-time" },
        "claim_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "money": {
      "type": "object",
      "required": ["amount", "currency", "basis"],
      "properties": {
        "amount": { "type": "number" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "basis": { "type": "string", "enum": ["hammer", "price_with_premium", "estimate_low", "estimate_high", "unknown"] },
        "normalized_amount": { "type": ["number", "null"] },
        "normalized_currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
        "fx_rate": { "type": ["number", "null"] },
        "fx_date": { "type": ["string", "null"], "format": "date" }
      }
    },
    "publicMarket": {
      "allOf": [
        { "$ref": "#/$defs/sectionState" },
        {
          "type": "object",
          "properties": {
            "provider": { "type": ["string", "null"] },
            "cutoff": { "type": ["string", "null"], "format": "date-time" },
            "first_recorded_auction": { "$ref": "#/$defs/dateValue" },
            "offered_lots": { "type": ["integer", "null"], "minimum": 0 },
            "sold_lots": { "type": ["integer", "null"], "minimum": 0 },
            "withdrawn_or_canceled_lots": { "type": ["integer", "null"], "minimum": 0 },
            "sell_through_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "total_sales_value": { "$ref": "#/$defs/money" },
            "median_sold_price": { "$ref": "#/$defs/money" },
            "average_sold_price": { "$ref": "#/$defs/money" },
            "medium_distribution": { "type": "array", "items": { "$ref": "#/$defs/categoryCount" } },
            "creation_period_distribution": { "type": "array", "items": { "$ref": "#/$defs/categoryCount" } },
            "auction_house_distribution": { "type": "array", "items": { "$ref": "#/$defs/categoryCount" } },
            "geography_distribution": { "type": "array", "items": { "$ref": "#/$defs/categoryCount" } },
            "annual_history": { "type": "array", "items": { "$ref": "#/$defs/annualMarketRecord" } },
            "top_results": { "type": "array", "items": { "$ref": "#/$defs/auctionResult" } },
            "sample_size_note": { "type": ["string", "null"] },
            "methodology_note": { "type": ["string", "null"] },
            "claim_ids": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "categoryCount": {
      "type": "object",
      "required": ["category", "count"],
      "properties": {
        "category": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "sold_count": { "type": ["integer", "null"], "minimum": 0 },
        "value": { "$ref": "#/$defs/money" }
      }
    },
    "annualMarketRecord": {
      "type": "object",
      "required": ["year", "offered_lots", "sold_lots"],
      "properties": {
        "year": { "type": "integer" },
        "offered_lots": { "type": "integer", "minimum": 0 },
        "sold_lots": { "type": "integer", "minimum": 0 },
        "sales_value": { "$ref": "#/$defs/money" },
        "median_sold_price": { "$ref": "#/$defs/money" }
      }
    },
    "auctionResult": {
      "type": "object",
      "required": ["work_title", "auction_house", "sale_date", "claim_ids"],
      "properties": {
        "work_title": { "type": "string" },
        "work_date": { "$ref": "#/$defs/dateValue" },
        "medium": { "type": ["string", "null"] },
        "dimensions_display": { "type": ["string", "null"] },
        "auction_house": { "type": "string" },
        "sale_title": { "type": ["string", "null"] },
        "sale_date": { "$ref": "#/$defs/dateValue" },
        "lot_number": { "type": ["string", "null"] },
        "estimate_low": { "$ref": "#/$defs/money" },
        "estimate_high": { "$ref": "#/$defs/money" },
        "hammer": { "$ref": "#/$defs/money" },
        "price_with_premium": { "$ref": "#/$defs/money" },
        "claim_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "event": {
      "type": "object",
      "required": ["event_type", "title", "date", "claim_ids"],
      "properties": {
        "event_type": { "type": "string" },
        "title": { "type": "string" },
        "date": { "$ref": "#/$defs/dateValue" },
        "description": { "type": ["string", "null"] },
        "related_entity_ids": { "type": "array", "items": { "type": "string" } },
        "claim_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "source": {
      "type": "object",
      "required": ["source_id", "title", "url", "tier", "accessed_at", "publisher"],
      "properties": {
        "source_id": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "tier": { "type": "integer", "enum": [1, 2, 3] },
        "source_type": { "type": "string" },
        "publisher": { "type": "string" },
        "author": { "type": ["string", "null"] },
        "published_at": { "type": ["string", "null"], "format": "date-time" },
        "accessed_at": { "type": "string", "format": "date-time" },
        "archived_url": { "type": ["string", "null"], "format": "uri" },
        "rights_note": { "type": ["string", "null"] }
      }
    },
    "claim": {
      "type": "object",
      "required": ["claim_id", "statement", "claim_type", "status", "source_ids", "generated_at"],
      "properties": {
        "claim_id": { "type": "string" },
        "statement": { "type": "string" },
        "claim_type": {
          "type": "string",
          "enum": ["fact", "artist_statement", "gallery_interpretation", "institutional_interpretation", "independent_criticism", "market_observation", "system_synthesis"]
        },
        "status": {
          "type": "string",
          "enum": ["verified_single_source", "verified_multiple_sources", "conflicting", "unverified", "not_found"]
        },
        "source_ids": { "type": "array", "items": { "type": "string" } },
        "confidence_basis": { "type": ["string", "null"] },
        "related_entity_ids": { "type": "array", "items": { "type": "string" } },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "limitation": {
      "type": "object",
      "required": ["code", "message", "affected_sections"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "affected_sections": { "type": "array", "items": { "type": "string" } },
        "severity": { "type": "string", "enum": ["info", "warning", "material"] }
      }
    }
  }
}
